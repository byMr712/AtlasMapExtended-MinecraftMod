{
  "schemaVersion": 1,
  "id": "atlasmapextended",
  "version": "1.1.1",
  "name": "AtlasMapExtended",
  "description": "A world map and minimap with 8 UI designs, colourable markers, screenshots, ruler, drawing tools and teleport. Maps are stored per server and per world.",
  "authors": ["erkinpaw", "Mr712"],
  "contact": {
    "homepage": "https://github.com/byMr712/AtlasMapExtended-MinecraftMod",
    "sources": "https://github.com/byMr712/AtlasMapExtended-MinecraftMod",
    "issues": "https://github.com/byMr712/AtlasMapExtended-MinecraftMod/issues"
  },
  "license": "MIT",
  "icon": "assets/atlasmapextended/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.webtrade.atlasmapextended.client.AtlasMapExtendedClient"
    ]
  },
  "mixins": [
    "atlasmapextended.mixins.json",
    {
      "config": "atlasmapextended.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
